# Google Analytics 4（本番のみ設定。開発では未設定のままにするとGAが読み込まれません）
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# 公開オリジン（サブドメイン）
NEXT_PUBLIC_SITE_URL=https://rangetable.yutar0xff.com

# basePath（サブドメイン直公開のため空。必要時のみ /apps/<slug> などを設定）
NEXT_PUBLIC_BASE_PATH=

# vercel.app 直アクセスを canonical へ寄せる
ENABLE_VERCEL_CANONICAL_REDIRECT=true
VERCEL_CANONICAL_REDIRECT_URL=https://rangetable.yutar0xff.com
